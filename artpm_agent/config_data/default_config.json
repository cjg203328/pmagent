{
  "llm": {
    "provider": "anthropic",
    "model": "claude-3-5-sonnet-20241022",
    "framework": "langchain",
    "vision_model": "",
    "available_models": [],
    "models_synced_at": null,
    "temperature": 0.4,
    "max_tokens": 1200,
    "retry_max_attempts": 1,
    "retry_backoff_factor": 2,
    "failover_max_attempts": 2,
    "failover_request_timeout_seconds": 8,
    "request_timeout_seconds": 12,
    "history_max_messages": 8,
    "history_max_chars": 4000,
    "response_cache_enabled": true,
    "response_cache_ttl": 1800,
    "response_cache_max_size": 512,
    "response_cache_redis_enabled": true,
    "intent_classification_enabled": false
  },
  "agent_runtime": {
    "model_tool_calls_enabled": false,
    "max_turns": 8,
    "max_tool_calls_per_turn": 16,
    "orchestration_framework": "langgraph",
    "langgraph_enabled": true,
    "langgraph_max_parallelism": 4,
    "langgraph_max_retries": 2,
    "memory_context_max_tokens": 1200
  },
  "unlimited_ocr": {
    "enabled": true,
    "base_url": "http://127.0.0.1:10000",
    "model": "Unlimited-OCR",
    "timeout": 120,
    "max_output": 32768,
    "allow_remote": false,
    "api_key": "",
    "no_repeat_ngram_size": 35,
    "ngram_window_single": 128,
    "ngram_window_multi": 1024,
    "custom_logit_processor": "",
    "runtime": {
      "managed": true,
      "manifest_path": "",
      "startup_timeout": 90,
      "health_interval": 10,
      "restart_cooldown": 5,
      "max_restarts": 2,
      "lock_timeout": 180,
      "state_dir": "./temp/unlimited_ocr",
      "log_path": "./logs/unlimited-ocr-runtime.log"
    }
  },
  "mineru": {
    "enabled": true,
    "mode": "auto",
    "command": "mineru",
    "api_url": "",
    "api_key": "",
    "api_key_header": "Authorization",
    "api_key_prefix": "Bearer",
    "api_path": "/file_parse",
    "health_path": "/health",
    "allow_insecure_http": false,
    "backend": "pipeline",
    "parse_method": "auto",
    "effort": "medium",
    "language": "ch",
    "formula_enable": true,
    "table_enable": true,
    "image_analysis": true,
    "timeout_seconds": 600,
    "connect_timeout_seconds": 10,
    "output_dir": "./data/mineru",
    "max_output_bytes": 134217728,
    "max_text_chars": 262144,
    "max_structured_bytes": 393216,
    "max_blocks": 5000,
    "max_archive_members": 10000,
    "cache_enabled": true,
    "cache_max_entries": 64
  },
  "database": {
    "db_path": "./data/artpm.db",
    "memory_db_path": "./data/memory.db",
    "conversation_db_path": "./data/conversations.db",
    "vector_db_path": "./data/vector_store"
  },
  "cost_config": {
    "staff_levels": {
      "初级": {
        "daily_cost": 300,
        "min_days": 1
      },
      "中级": {
        "daily_cost": 500,
        "min_days": 1
      },
      "中高级": {
        "daily_cost": 700,
        "min_days": 1
      },
      "高级": {
        "daily_cost": 1000,
        "min_days": 1
      },
      "资深": {
        "daily_cost": 1500,
        "min_days": 1
      }
    },
    "overhead_rate": 0.15,
    "tax_rate": 0.06,
    "currency": "CNY"
  },
  "wecom": {
    "enabled": false,
    "corp_id": "",
    "agent_id": "",
    "secret": "",
    "webhook_url": "",
    "note": "配置完成后设为true即可启用真实推送"
  },
  "file_processing": {
    "max_file_size_mb": 50,
    "supported_formats": ["xlsx", "xls", "csv", "json", "txt", "md", "pdf", "docx", "pptx", "png", "jpg", "jpeg", "webp", "bmp", "gif", "jp2", "tif", "tiff"],
    "ocr_language": "ch"
  },
  "task_allocation": {
    "max_load_per_person": 20,
    "prefer_same_person": true
  },
  "progress_tracking": {
    "warning_days_ahead": 1,
    "check_interval_hours": 24
  },
  "memory": {
    "embedding_provider": "local_feature_hash",
    "embedding_model": "char-ngram-feature-hash-v1",
    "embedding_dimension": 1536,
    "vector_top_k": 5,
    "short_term_memory_days": 7
  }
}
