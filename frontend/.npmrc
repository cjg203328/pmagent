# Keep pnpm's content-addressable store and npm cache inside the repository.
# The workspace convention (see README 本地端口分配) is that build/test
# artifacts never accumulate on the system drive. Forward slashes keep the
# ini parser from treating Windows path separators as escapes.
store-dir=E:/desk/xm/artpm/pmagent/.cache/pnpm-store
cache-dir=E:/desk/xm/artpm/pmagent/.cache/npm-cache
state-dir=E:/desk/xm/artpm/pmagent/.cache/pnpm-state
