# The application works offline when API keys are empty.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
# Interactive defaults prioritize first response. Raise only for long-form tasks.
LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_MAX_TOKENS=1200
LLM_HISTORY_MAX_MESSAGES=8
LLM_HISTORY_MAX_CHARS=4000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZHIPU_API_KEY=

# Structured model tool calls are opt-in. Enable only when the host supplies an
# approval hook; data-access and write tools fail closed without one.
AGENT_MODEL_TOOL_CALLS_ENABLED=false

DB_PATH=./data/artpm.db
MEMORY_DB_PATH=./data/memory.db
VECTOR_DB_PATH=./data/vector_store
# Internal vectorization settings. Changing either value rebuilds the FAISS index.
EMBEDDING_PROVIDER=local_feature_hash
EMBEDDING_DIMENSION=1536

OVERHEAD_RATE=0.15
TAX_RATE=0.06

# Optional remote MCP service. Local file/data tools do not require this.
MCP_ENABLED=false
SKILLS_FORGE_URL=
SKILLS_FORGE_KEY=
MCP_ALLOW_COMMANDS=false

# Deployment-managed OCR endpoint. Agent skills invoke it automatically; the
# runtime manifest, Python environment, and model weights live in the deployment
# bundle and are never exposed as end-user settings.
UNLIMITED_OCR_ENABLED=true
UNLIMITED_OCR_BASE_URL=http://127.0.0.1:10000
UNLIMITED_OCR_MODEL=Unlimited-OCR
UNLIMITED_OCR_TIMEOUT=120
UNLIMITED_OCR_MAX_OUTPUT=32768
UNLIMITED_OCR_ALLOW_REMOTE=false
UNLIMITED_OCR_API_KEY=
# Optional SGLang serialized processor generated by the Unlimited-OCR runtime.
UNLIMITED_OCR_NGRAM_SIZE=35
UNLIMITED_OCR_NGRAM_WINDOW_SINGLE=128
UNLIMITED_OCR_NGRAM_WINDOW_MULTI=1024
UNLIMITED_OCR_CUSTOM_LOGIT_PROCESSOR=
