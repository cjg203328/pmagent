# The application works offline when API keys are empty.
# local enables the OS folder picker; cloud/container/remote/server keeps every
# storage setting server-path based and hides desktop-only controls.
ARTPM_DEPLOYMENT_MODE=local
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
# Model framework: langchain (recommended) or native (legacy compatibility)
LLM_FRAMEWORK=langchain
# Interactive defaults prioritize first response. Raise only for long-form tasks.
LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_FAILOVER_MAX_ATTEMPTS=2
LLM_FAILOVER_REQUEST_TIMEOUT_SECONDS=8
LLM_MAX_TOKENS=1200
LLM_HISTORY_MAX_MESSAGES=8
LLM_HISTORY_MAX_CHARS=4000
# Exact-response cache. Keys include model settings, history, attachment content,
# and tenant/workspace scope. Redis becomes a shared L2 when REDIS_URL is set.
ARTPM_RESPONSE_CACHE=true
ARTPM_RESPONSE_CACHE_TTL=1800
ARTPM_RESPONSE_CACHE_MAX_SIZE=512
ARTPM_RESPONSE_CACHE_REDIS=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZHIPU_API_KEY=

# Optional real-time voice channel (disabled by default). Install with
# `python -m pip install -e ".[voice]"` before enabling this block. When the
# voice provider is unavailable or keys are empty, the UI keeps text chat and
# can fall back to text-only responses; no provider call is attempted.
ARTPM_VOICE_ENABLED=false
ARTPM_VOICE_TRANSPORT=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_PREFIX=artpm
ARTPM_VOICE_AGENT_NAME=artpm-voice
VOICE_STT_PROVIDER=cartesia
VOICE_STT_MODEL=ink-whisper
VOICE_STT_LANGUAGE=zh
VOICE_TTS_PROVIDER=minimax
VOICE_TTS_FALLBACKS=minimax,cartesia,local,text
CARTESIA_API_KEY=
MINIMAX_API_KEY=
VOICE_TTS_MODEL=
VOICE_TTS_VOICE_ID=
VOICE_REQUIRE_APPROVAL=true
VOICE_MAX_SESSION_SECONDS=1800
VOICE_MAX_RECORDING_BYTES=20971520
# `local` is an optional operator-installed TTS; `text` always keeps the
# existing PMAgent response path when no voice provider is available.
VOICE_FALLBACK=text

# Structured model tool calls are opt-in. Enable only when the host supplies an
# approval hook; data-access and write tools fail closed without one.
AGENT_MODEL_TOOL_CALLS_ENABLED=false

# Agent task orchestration. New collaborative flows use LangGraph; the
# existing persisted linear WorkflowEngine remains available as a compatibility
# path. The graph is activated by the task-graph API, not by ordinary chat.
AGENT_ORCHESTRATION_FRAMEWORK=langgraph
LANGGRAPH_ENABLED=true
LANGGRAPH_MAX_PARALLELISM=4
LANGGRAPH_MAX_RETRIES=2
# Maximum long-term memory context injected into one model turn.
# Set to 0 to disable automatic memory injection for a deployment.
MEMORY_CONTEXT_MAX_TOKENS=1200

# Application logging. time rotates at midnight; size rotates at max bytes;
# none disables rotation but still writes the configured file.
ARTPM_LOG_LEVEL=INFO
ARTPM_LOG_DIR=
ARTPM_LOG_FILE=artpm.log
ARTPM_LOG_ROTATION=time
ARTPM_LOG_WHEN=midnight
ARTPM_LOG_INTERVAL=1
ARTPM_LOG_BACKUP_COUNT=14
ARTPM_LOG_MAX_BYTES=10485760
ARTPM_LOG_UTC=false

# REST gateway. In production set ARTPM_ENV=production and provide a secret;
# the trusted ingress must inject X-Gateway-Token plus tenant/workspace headers.
# An empty secret is accepted only for direct loopback requests, never through a proxy.
ARTPM_ENV=development
ARTPM_GATEWAY_SHARED_SECRET=
ARTPM_API_HOST=127.0.0.1
ARTPM_API_PORT=8765
# Explicit browser origins allowed to call the gateway (comma-separated).
ARTPM_CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

DB_PATH=./data/artpm.db
MEMORY_DB_PATH=./data/memory.db
VECTOR_DB_PATH=./data/vector_store
# Internal vectorization settings. Changing either value rebuilds the FAISS index.
EMBEDDING_PROVIDER=local_feature_hash
EMBEDDING_DIMENSION=1536

OVERHEAD_RATE=0.15
TAX_RATE=0.06

# Optional Redis cache (token-usage + episode aggregates). When unset, the app
# transparently falls back to its local SQLite store — Redis is an acceleration
# layer, never a hard dependency. The docker-compose stack sets this to
# redis://redis:6379/0 by default.
REDIS_URL=

# Optional remote MCP service. Local file/data tools do not require this.
MCP_ENABLED=false
# Recommended transport: starts the official Skills Forge MCP server over stdio.
MCP_TRANSPORT=stdio
# stdio 空闲连接健康检查间隔（秒）；设为 0 可关闭后台心跳
MCP_HEARTBEAT_INTERVAL=30
MCP_SKILLS_CACHE_TTL=300
# Only required by the legacy HTTP transport.
SKILLS_FORGE_URL=
SKILLS_FORGE_KEY=
MCP_ALLOW_COMMANDS=false
# Optional executable allowlist for execute_command (comma-separated basenames).
# Empty = allow any command once MCP_ALLOW_COMMANDS=true; non-empty = only these
# executables may run (e.g. MCP_COMMAND_ALLOWLIST=ls,cat,python).
MCP_COMMAND_ALLOWLIST=

# Optional operator-installed Python skill plugins. Disabled by default.
# When enabled, both values must be JSON arrays. Roots must be absolute paths;
# every plugin ID must be explicitly allowlisted and every manifest must pin
# its module SHA-256. Request parameters can never choose a plugin path.
ARTPM_PLUGINS_ENABLED=false
ARTPM_PLUGIN_ROOTS=[]
ARTPM_PLUGIN_ALLOWLIST=[]

# Caddy basic-auth credentials (REQUIRED in production). Generate the hash on the
# host with:  docker run --rm caddy:2-alpine caddy hash-password
# docker-compose.yml requires both variables via ${VAR:?...}; unset => deploy fails.
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# Deployment-managed OCR endpoint. Agent skills invoke it automatically; the
# runtime manifest, Python environment, and model weights live in the deployment
# bundle and are never exposed as end-user settings.
UNLIMITED_OCR_ENABLED=true
UNLIMITED_OCR_BASE_URL=http://127.0.0.1:10000
UNLIMITED_OCR_MODEL=Unlimited-OCR
UNLIMITED_OCR_TIMEOUT=120
UNLIMITED_OCR_MAX_OUTPUT=32768
UNLIMITED_OCR_ALLOW_REMOTE=false
UNLIMITED_OCR_API_KEY=
# Optional SGLang serialized processor generated by the Unlimited-OCR runtime.
UNLIMITED_OCR_NGRAM_SIZE=35
UNLIMITED_OCR_NGRAM_WINDOW_SINGLE=128
UNLIMITED_OCR_NGRAM_WINDOW_MULTI=1024
UNLIMITED_OCR_CUSTOM_LOGIT_PROCESSOR=

# Optional MinerU multimodal document backend.  The main app stays lightweight:
# use a local `mineru` CLI or point this at an isolated `mineru-api` sidecar.
# MinerU is treated as an accelerator; missing/failed conversion falls back to
# the built-in parsers and OCR path.
MINERU_ENABLED=true
MINERU_MODE=auto                 # auto / local / remote / disabled
MINERU_COMMAND=mineru            # local CLI or `python -m mineru`
MINERU_API_URL=                  # e.g. http://127.0.0.1:8000
MINERU_API_KEY=
MINERU_API_KEY_HEADER=Authorization
MINERU_API_KEY_PREFIX=Bearer
MINERU_API_PATH=/file_parse
MINERU_HEALTH_PATH=/health
MINERU_ALLOW_INSECURE_HTTP=false  # only for trusted internal non-HTTPS endpoints
MINERU_BACKEND=pipeline          # pipeline / hybrid-engine / vlm-engine / *-http-client
MINERU_PARSE_METHOD=auto         # auto / txt / ocr
MINERU_EFFORT=medium             # medium / high (hybrid backends)
MINERU_LANGUAGE=ch
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_IMAGE_ANALYSIS=true
MINERU_TIMEOUT_SECONDS=600
MINERU_CONNECT_TIMEOUT_SECONDS=10
MINERU_OUTPUT_DIR=./data/mineru
MINERU_MAX_OUTPUT_BYTES=134217728
MINERU_MAX_TEXT_CHARS=262144
MINERU_MAX_STRUCTURED_BYTES=393216
MINERU_MAX_BLOCKS=5000
MINERU_CACHE_ENABLED=true
MINERU_CACHE_MAX_ENTRIES=64
