# ArtPM Agent — 反向代理 + 自动 HTTPS + 基础认证（Caddy）
#
# 站点域名由 docker-compose 通过环境变量 SITE_ADDRESS 注入：
#   • 留空 / localhost    → Caddy 用本地 CA 签发证书（本机 https://localhost 测试用）
#   • 真实域名（如 pmagent.example.com）→ 自动向 Let's Encrypt 申请并续期证书
#
# 基础认证（basicauth）强制开启，避免服务裸奔到公网。
# 凭据必须来自部署环境变量，镜像/仓库内不内置任何默认账号或密码：
#   • BASIC_AUTH_USER  —— 认证用户名（如 admin）
#   • BASIC_AUTH_HASH  —— bcrypt 哈希，由宿主机生成：
#       docker run --rm caddy:2-alpine caddy hash-password
#       按提示输入你的密码，得到 $2a$... 哈希，写入 .env 的 BASIC_AUTH_HASH。
#   • docker-compose.yml 中这两个变量用 ${VAR:?...} 声明为必填；
#     未设置时 `docker compose up` 会在配置阶段直接报错，不会以弱默认启动。
#
# 注意：reverse_proxy 指向 compose 网络内的服务名 artpm-agent:8501，
# 不要写 localhost（在 Caddy 容器内 localhost 是它自己，不是 app）。

{$SITE_ADDRESS:localhost} {
    # 全站基础认证（不写 matcher 即作用于所有路径）
    basicauth {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    }

    # Streamlit 依赖 WebSocket 长连接，reverse_proxy 默认已支持
    reverse_proxy artpm-agent:8501

    # 可选：上传大文件（知识库导入）时放宽超时
    # reverse_proxy artpm-agent:8501 {
    #     transport http {
    #         read_timeout 300s
    #     }
    # }
}
