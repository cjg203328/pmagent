# ArtPM Agent — 反向代理 + 自动 HTTPS + 基础认证（Caddy）
#
# 站点域名由 docker-compose 通过环境变量 SITE_ADDRESS 注入：
#   • 留空 / localhost    → Caddy 用本地 CA 签发证书（本机 https://localhost 测试用）
#   • 真实域名（如 pmagent.example.com）→ 自动向 Let's Encrypt 申请并续期证书
#
# 基础认证（basicauth）默认开启，避免服务裸奔到公网：
#   • 默认账号 admin / 密码 ArtPM@2026#redis-default（哈希已内嵌在下方 {$BASIC_AUTH_HASH:...}）
#   • ⚠️ 部署到公网前务必改成自己的密码：
#       在宿主机执行   docker run --rm caddy:2-alpine caddy hash-password
#       按提示输入密码，得到 $2a$... 哈希；
#       把 docker-compose.yml 里 caddy 服务的 BASIC_AUTH_HASH 环境变量设为该哈希
#       （见 docker-compose.yml 注释，取消对应行即可），即可覆盖默认。
#
# 注意：reverse_proxy 指向 compose 网络内的服务名 artpm-agent:8501，
# 不要写 localhost（在 Caddy 容器内 localhost 是它自己，不是 app）。

{$SITE_ADDRESS:localhost} {
    # 全站基础认证（不写 matcher 即作用于所有路径）
    basicauth {
        admin {$BASIC_AUTH_HASH:$2a$12$s/ueo9wac8n66IhDGVLKluOMBrsoikl1EuXZEKt4lTjVSovTvjAmu}
    }

    # Streamlit 依赖 WebSocket 长连接，reverse_proxy 默认已支持
    reverse_proxy artpm-agent:8501

    # 可选：上传大文件（知识库导入）时放宽超时
    # reverse_proxy artpm-agent:8501 {
    #     transport http {
    #         read_timeout 300s
    #     }
    # }
}
