# ArtPM Agent — 反向代理 + 自动 HTTPS + 基础认证（Caddy）
#
# 站点域名由 docker-compose 通过环境变量 SITE_ADDRESS 注入：
#   • 留空 / localhost    → Caddy 用本地 CA 签发证书（本机 https://localhost 测试用）
#   • 真实域名（如 pmagent.example.com）→ 自动向 Let's Encrypt 申请并续期证书
#
# 基础认证（basicauth）强制开启，避免服务裸奔到公网。
# 凭据必须来自部署环境变量，镜像/仓库内不内置任何默认账号或密码：
#   • BASIC_AUTH_USER  —— 认证用户名（如 admin）
#   • BASIC_AUTH_HASH  —— bcrypt 哈希，由宿主机生成：
#       docker run --rm caddy:2-alpine caddy hash-password
#       按提示输入你的密码，得到 $2a$... 哈希，写入 .env 的 BASIC_AUTH_HASH。
#   • docker-compose.yml 中这两个变量用 ${VAR:?...} 声明为必填；
#     未设置时 `docker compose up` 会在配置阶段直接报错，不会以弱默认启动。
#
# 注意：reverse_proxy 指向 compose 网络内的服务名，
# 不要写 localhost（在 Caddy 容器内 localhost 是它自己，不是 app）。

{$SITE_ADDRESS:localhost} {
    # 全站基础认证（不写 matcher 即作用于所有路径）
    basicauth {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    }

    # The API keeps its native /health and /v1 paths; handle_path strips the
    # public /api prefix before proxying (e.g. /api/health -> /health).
    handle_path /api/* {
        # Remove all client-controlled identity headers, then inject the
        # identity established by the trusted ingress configuration.
        reverse_proxy artpm-api:8765 {
            header_up -X-Gateway-Token
            header_up -X-Tenant-ID
            header_up -X-Workspace-ID
            header_up -X-Actor-ID
            header_up -X-Actor-Role
            header_up -X-Actor-Kind
            header_up X-Gateway-Token {$ARTPM_GATEWAY_SHARED_SECRET}
            header_up X-Tenant-ID {$ARTPM_GATEWAY_TENANT_ID}
            header_up X-Workspace-ID {$ARTPM_GATEWAY_WORKSPACE_ID}
            header_up X-Actor-ID {$ARTPM_GATEWAY_ACTOR_ID}
            header_up X-Actor-Role {$ARTPM_GATEWAY_ACTOR_ROLE}
            header_up X-Actor-Kind {$ARTPM_GATEWAY_ACTOR_KIND}
        }
    }

    # Streamlit depends on WebSocket long connections; reverse_proxy supports
    # those by default.
    handle {
        reverse_proxy artpm-agent:8501
    }

    # 可选：上传大文件（知识库导入）时放宽超时
    # reverse_proxy artpm-agent:8501 {
    #     transport http {
    #         read_timeout 300s
    #     }
    # }
}
